window-decoration = false 
term = xterm-256color
confirm-close-surface = false

font-family = "Noto Sans Mono"
font-size = 14

# for tmux
keybind = ctrl+1=text:\x1bz1
keybind = ctrl+2=text:\x1bz2
keybind = ctrl+3=text:\x1bz3
keybind = ctrl+4=text:\x1bz4
keybind = ctrl+5=text:\x1bz5
keybind = ctrl+6=text:\x1bz6
keybind = ctrl+7=text:\x1bz7
keybind = ctrl+8=text:\x1bz8
keybind = ctrl+9=text:\x1bz9

keybind = ctrl+s=text:\x1bzs
keybind = ctrl+e=text:\x1bze
keybind = ctrl+shift+c=copy_to_clipboard:plain
